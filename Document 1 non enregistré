href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">



  <style>

/* =================================
   SPEED GARAGE PRO — DESIGN PREMIUM
================================= */

/* GLOBAL */
*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    padding: 0;
    font-family: 'Poppins', sans-serif;
    background: #101216;
    color: #f5f5f5;
    line-height: 1.6;
    overflow-x: hidden;
}

img {
    max-width: 100%;
    height: auto;
}

button {
    font-family: inherit;
    cursor: pointer;
}

a {
    transition: all 0.3s ease;
}

/* BOUTONS */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 25px;
    margin: 10px;
    border: none;
    border-radius: 8px;
    background: linear-gradient(135deg, #e31b23, #b90e16);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 5px 18px rgba(227, 27, 35, 0.20);
}

.btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 9px 25px rgba(227, 27, 35, 0.35);
}

.btn-red {
    background: linear-gradient(135deg, #e31b23, #b90e16);
    color: white;
}

.btn-yellow {
    background: linear-gradient(135deg, #ffd43b, #e5a900);
    color: #171717;
}

/* HEADER */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
    padding: 15px 5%;
    background: rgba(8, 9, 11, 0.96);
    border-bottom: 2px solid #e31b23;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(10px);
    position: relative;
    z-index: 100;
}

.logo {
    width: 180px;
    max-width: 100%;
    transition: transform 0.3s ease;
}

.logo:hover {
    transform: scale(1.05);
}

.right-header {
    display: flex;
    align-items: center;
    gap: 25px;
}

/* MENU */
nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    background: #191c21;
    padding: 12px 20px;
}

nav a,
.menu a {
    color: #f5f5f5;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
}

nav a:hover,
.menu a:hover {
    color: #ff343b;
}

.menu {
    display: flex;
    align-items: center;
    gap: 22px;
}

/* MENU DÉROULANT */
.dropdown {
    position: relative;
}

.dropdown-content {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 170px;
    padding: 8px;
    background: #191c21;
    border: 1px solid #333;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    z-index: 200;
}

.dropdown-content a {
    display: block;
    padding: 10px;
}

.dropdown:hover .dropdown-content {
    display: block;
}

/* RÉSEAUX SOCIAUX */
.socials {
    display: flex;
    align-items: center;
    gap: 15px;
}

.socials a {
    color: white;
    font-size: 19px;
    transition: all 0.3s ease;
}

.socials a:hover {
    color: #ff343b;
    transform: translateY(-3px);
}

footer .socials {
    justify-content: center;
}

footer .socials a {
    font-size: 20px;
}


/* ACCUEIL PREMIUM */
.hero-premium {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 45px;
    padding: 75px 7%;
    min-height: 510px;
    text-align: left;
    background:
        radial-gradient(circle at 85% 20%, rgba(227,27,35,.18), transparent 35%),
        linear-gradient(135deg, #171a20, #090b0e);
}

.hero-content {
    max-width: 650px;
}

.hero-eyebrow {
    display: inline-block;
    color: #ffd43b;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
}

.hero-premium h1 {
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.18;
    margin: 0 0 22px;
    color: #fff;
}

.hero-premium h1 span {
    display: block;
    color: #ff343b;
}

.hero-premium p {
    max-width: 560px;
    margin: 0 0 25px;
    color: #c5c5c5;
    font-size: 16px;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.hero-actions .btn {
    margin: 5px 0;
}

.hero-services {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 25px;
    color: #ddd;
    font-size: 13px;
}

.hero-services i {
    color: #ffd43b;
    margin-right: 5px;
}

.hero-visual {
    position: relative;
}

.hero-visual img {
    display: block;
    width: 100%;
    height: 340px;
    object-fit: cover;
    border-radius: 18px;
    border: 2px solid #e31b23;
    box-shadow: 0 15px 40px rgba(0,0,0,.45);
}

.hero-image-label {
    position: absolute;
    bottom: 15px;
    left: 15px;
    right: 15px;
    padding: 12px;
    background: rgba(8,9,11,.88);
    border-radius: 9px;
    color: white;
    font-weight: 600;
}

.hero-image-label i {
    color: #ffd43b;
    margin-right: 8px;
}

@media (max-width: 768px) {
    .hero-premium {
        grid-template-columns: 1fr;
        padding: 45px 18px;
        gap: 30px;
        text-align: center;
    }

    .hero-premium p {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-actions,
    .hero-services {
        justify-content: center;
    }

    .hero-visual img {
        height: 250px;
    }
}


/* SECTIONS */
.section {
    padding: 60px 20px;
    text-align: center;
}

.section h2 {
    font-size: clamp(24px, 4vw, 34px);
    margin-bottom: 15px;
    color: #fff;
}

.section h2::after {
    content: "";
    display: block;
    width: 65px;
    height: 4px;
    margin: 12px auto 0;
    background: #e31b23;
    border-radius: 5px;
}

/* SERVICES */
.features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 22px;
}

.card {
    width: 220px;
    padding: 22px;
    background: linear-gradient(145deg, #22262d, #171a20);
    border: 1px solid #30343c;
    border-radius: 14px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.25);
    transition: all 0.3s ease;
}

.card:hover {
    transform: translateY(-6px);
    border-color: #e31b23;
    box-shadow: 0 12px 25px rgba(227, 27, 35, 0.18);
}

.service-btn {
    width: 200px;
    padding: 15px 20px;
    background: #20242b;
    color: white;
    border: 1px solid #e31b23;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.service-btn:hover {
    background: #e31b23;
    transform: translateY(-3px);
    box-shadow: 0 7px 18px rgba(227, 27, 35, 0.3);
}

.service-img {
    display: block;
    width: min(100%, 350px);
    margin: 25px auto;
    border-radius: 14px;
    border: 1px solid #363a42;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s ease;
}

.service-img:hover {
    transform: scale(1.03);
}

/* ENTRETIEN */
.entretien h3 {
    margin-top: 30px;
    color: #ffd43b;
}

.entretien .card {
    width: 220px;
    background: #191c21;
    border: 1px solid #454545;
}

.entretien .card:hover {
    border-color: #e31b23;
}

/* VOITURES D'OCCASION */
.car-slider {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    padding: 20px 10px;
    scroll-behavior: smooth;
}

.car-slider::-webkit-scrollbar {
    height: 6px;
}

.car-slider::-webkit-scrollbar-thumb {
    background: #e31b23;
    border-radius: 10px;
}

.car-card {
    min-width: 240px;
    background: #191c21;
    border: 1px solid #30343c;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
}

.car-card:hover {
    transform: translateY(-5px);
    border-color: #e31b23;
}

.car-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
}

.car-card h3 {
    font-size: 17px;
    margin: 12px 0 5px;
    color: #ffd43b;
}

.car-card p {
    font-size: 14px;
    padding: 0 10px 12px;
    color: #ccc;
}

/* SLIDER D'IMAGES */
.slider-container {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    position: relative;
    margin-top: 25px;
}

.slider-track {
    display: flex;
    width: max-content;
    min-width: max-content;
    animation: scrollLeft 20s linear infinite;
}

.slider-track img {
    width: 300px;
    height: 180px;
    object-fit: cover;
    border-radius: 12px;
    margin-right: 15px;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.4);
}

.slider-container:hover .slider-track {
    animation-play-state: paused;
}

@keyframes scrollLeft {
    from {
        transform: translateX(0);
    }
    to {
        transform: translateX(-50%);
    }
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: scale(0.97);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* MODALS : RÉSERVATION ET DEVIS */
.modal {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 16px;
    background: rgba(0, 0, 0, 0.82);
    justify-content: center;
    align-items: center;
    overflow-y: auto;
    z-index: 999;
}

.modal-box {
    width: min(100%, 440px);
    max-height: 90vh;
    overflow-y: auto;
    padding: 28px;
    background: #20242b;
    border: 1px solid #444;
    border-top: 3px solid #e31b23;
    border-radius: 14px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.55);
    animation: fadeIn 0.25s ease;
}

/* CHAMPS DES FORMULAIRES */
input,
select,
textarea {
    display: block;
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    border: 1px solid #444;
    border-radius: 7px;
    background: #f5f5f5;
    color: #171717;
    font: inherit;
}

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: #e31b23;
    box-shadow: 0 0 0 3px rgba(227, 27, 35, 0.15);
}

/* ÉLÉMENTS SÉLECTIONNABLES */
.selectable {
    cursor: pointer;
    transition: all 0.3s ease;
}

.selectable.selected {
    background: #e31b23;
    color: white;
    transform: scale(1.03);
    box-shadow: 0 5px 15px rgba(227, 27, 35, 0.35);
}

/* FOOTER */
footer {
    background: #08090b;
    text-align: center;
    padding: 25px 20px;
    margin-top: 40px;
}

.footer-pro {
    background: linear-gradient(180deg, #08090b, #15181e);
    color: white;
    padding: 45px 5% 20px;
    margin-top: 50px;
    border-top: 2px solid #e31b23;
}

.footer-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 30px;
}

.footer-col {
    flex: 1;
    min-width: 200px;
}

.footer-col h3,
.footer-col h4 {
    color: #ff343b;
    margin-bottom: 12px;
}

.footer-col ul {
    list-style: none;
    padding: 0;
}

.footer-col ul li {
    margin: 9px 0;
    cursor: pointer;
    transition: 0.3s;
}

.footer-col ul li:hover {
    color: #ff343b;
    transform: translateX(4px);
}

.footer-col a {
    overflow-wrap: anywhere;
}

.footer-pro .socials {
    display: flex;
    gap: 15px;
    margin-top: 12px;
}

.footer-pro .socials a {
    font-size: 19px;
    color: white;
}

.footer-pro .socials a:hover {
    color: #ff343b;
    transform: scale(1.15);
}

.whatsapp-btn {
    display: inline-block;
    margin-top: 12px;
    padding: 11px 18px;
    background: #25D366;
    color: white;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: 0.3s;
}

.whatsapp-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(37, 211, 102, 0.25);
}

.footer-bottom {
    text-align: center;
    margin-top: 30px;
    border-top: 1px solid #333;
    padding-top: 15px;
    font-size: 14px;
    color: #aaa;
}

/* ACCESSIBILITÉ */
button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
    outline: 3px solid #ffd43b;
    outline-offset: 3px;
}

/* RESPONSIVE : TABLETTES ET TÉLÉPHONES */
@media (max-width: 768px) {
    .header {
        padding: 14px;
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .logo {
        width: 145px;
    }

    .right-header {
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .menu {
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
    }

    nav {
        flex-wrap: wrap;
        gap: 12px;
    }

    .hero {
        padding: 55px 15px;
    }

    .section {
        padding: 40px 14px;
    }

    .features {
        gap: 14px;
    }

    .card {
        width: min(100%, 300px);
    }

    .service-btn {
        width: min(100%, 300px);
    }

    .footer-container {
        flex-direction: column;
    }

    .modal-box {
        padding: 22px;
    }
}

@media (max-width: 480px) {
    .hero h1 {
        font-size: 27px;
    }

    .btn {
        max-width: 100%;
        padding: 12px 18px;
        font-size: 14px;
    }

    .slider-track img {
        width: 230px;
        height: 145px;
    }

    .car-card {
        min-width: 210px;
    }
}

/* RESPECT DU MOUVEMENT RÉDUIT */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}

.hero-video {
    display: block;
    width: 100%;
    height: 340px;
    object-fit: cover;
    border-radius: 18px;
    border: 2px solid #e31b23;
    background: #000;
    box-shadow: 0 15px 40px rgba(0,0,0,.45);
}

@media (max-width: 768px) {
    .hero-video {
        height: 250px;
    }
}


/* ===== SERVICES PREMIUM ===== */

.services-premium {
    background: linear-gradient(180deg, #101216, #171a20);
    padding: 75px 5%;
}

.services-subtitle {
    color: #ffd43b;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
}

.services-intro {
    max-width: 650px;
    margin: 0 auto 40px;
    color: #bfc2c8;
}

.services-premium .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    max-width: 1150px;
    margin: 35px auto;
}

.service-card {
    position: relative;
    min-height: 245px;
    padding: 28px 22px;
    text-align: left;
    color: white;
    background: linear-gradient(145deg, #252a33, #15181e);
    border: 1px solid #343a44;
    border-radius: 16px;
    cursor: pointer;
    transition: transform .3s ease, border-color .3s ease,
                box-shadow .3s ease;
}

.service-card:hover {
    transform: translateY(-9px);
    border-color: #e31b23;
    box-shadow: 0 15px 35px rgba(227, 27, 35, .2);
}

.service-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    margin-bottom: 20px;
    border-radius: 14px;
    background: rgba(227, 27, 35, .15);
    color: #ff343b;
    font-size: 25px;
}

.service-card h3 {
    margin: 0 0 10px;
    color: #ffd43b;
    font-size: 18px;
}

.service-card p {
    margin: 0 0 20px;
    color: #c5c5c5;
    font-size: 14px;
    line-height: 1.6;
}

.service-link {
    color: #ff454b;
    font-size: 13px;
    font-weight: 700;
}

.service-link i {
    margin-left: 6px;
    transition: transform .3s;
}

.service-card:hover .service-link i {
    transform: translateX(5px);
}

.service-card:focus-visible {
    outline: 3px solid #ffd43b;
    outline-offset: 4px;
}

@media(max-width: 850px) {
    .services-premium .features {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media(max-width: 520px) {
    .services-premium .features {
        grid-template-columns: 1fr;
    }

    .service-card {
        min-height: 210px;
    }
}


  </style>
</head>
