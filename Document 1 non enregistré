<script>
/* OUVERTURE / FERMETURE DES MODALS */

firebase.auth().onAuthStateChanged(async (user) => {
  if (!user) {
    try {
      await firebase.auth().signInAnonymously();
      console.log("Connexion client Firebase réussie");
    } catch (error) {

  console.error('Erreur réservation :', error);

  feedback.textContent =
    error.message === 'Ce créneau est déjà réservé.'
      ? 'Désolé, ce créneau vient d’être réservé. Choisissez une autre heure.'
      : 'Impossible de réserver. Vérifiez votre connexion et réessayez.';

  refreshSlots();

}
  }
});

function openDevis() { document.getElementById('devisModal').style.display = 'flex'; }
function closeDevis() { document.getElementById('devisModal').style.display = 'none'; }

function openReservation() { document.getElementById('reservationModal').style.display = 'flex'; refreshSlots(); }
function closeReservation() { document.getElementById('reservationModal').style.display = 'none'; }

/* ENVOI DU DEVIS */
function sendDevis() {
  const nom = d_nom.value;
  const email = d_email.value;
  const tel = d_tel.value;
  const marque = d_marque.value;
  const modele = d_modele.value;
  const annee = d_annee.value;
  const km = d_km.value;
  const probleme = d_probleme.value;

  if(!nom || !email || !probleme){
    alert('Veuillez remplir les champs obligatoires');
    return;
  }

  const message = encodeURIComponent(
    `Demande de devis 🚗\nNom: ${nom}\nEmail: ${email}\nTel: ${tel}\nVéhicule: ${marque} ${modele} (${annee})\nKM: ${km}\nProblème: ${probleme}`
  );

  window.open(`https://wa.me/224613816381?text=${message}`, '_blank');
  // Le client doit appuyer sur Envoyer dans WhatsApp pour transmettre le devis.
  closeDevis();
}

/* Créneaux publics sans informations personnelles. Fuseau : Africa/Conakry (UTC). */
const HOURS = ['08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00'];
const el = id => document.getElementById(id);
const todayConakry = () => new Intl.DateTimeFormat('en-CA',{timeZone:'Africa/Conakry',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
function validDay(date){const d=new Date(date+'T12:00:00Z');return /^\d{4}-\d{2}-\d{2}$/.test(date)&&!isNaN(d)&&d.toISOString().slice(0,10)===date&&d.getUTCDay()!==0;}
let slotListener=null;
function refreshSlots(){
 const date=el('date').value, select=el('time'); select.replaceChildren(new Option('Sélectionner une heure',''));
 if(slotListener){slotListener();slotListener=null;}
 if(!date||!validDay(date)||date<todayConakry()){el('slotsFeedback').textContent='Choisissez une date future du lundi au samedi.';return;}
 if(!window.garageDb){el('slotsFeedback').textContent='Configurez Firebase.';return;}
 el('slotsFeedback').textContent='Chargement des disponibilités…';
 slotListener=garageDb.collection('slots').where('date','==',date).onSnapshot(snap=>{
  const taken=new Set(snap.docs.filter(d=>d.data().occupied===true).map(d=>d.data().time));
  const current=select.value;select.replaceChildren(new Option('Choisir une heure',''));
  for(const h of HOURS){const past=(date+'T'+h+':00Z')<=new Date().toISOString();if(!taken.has(h)&&!past)select.add(new Option(h,h));}
  if([...select.options].some(o=>o.value===current))select.value=current;
  el('slotsFeedback').textContent=(select.options.length-1)+' créneau(x) libre(s)';
 },()=>el('slotsFeedback').textContent='Impossible de charger les créneaux.');
}
el('date').min=todayConakry();el('date').addEventListener('change',refreshSlots);
let savingReservation = false;

async function sendReservation() {
  if (savingReservation) return;

  const el = id => document.getElementById(id);
  const feedback = el('reservationFeedback');

  const data = Object.fromEntries(
    ['name', 'email', 'phone', 'vehicle', 'date', 'time', 'service']
      .map(k => [k, el(k).value.trim()])
  );

  if (Object.values(data).some(v => !v)) {
    feedback.textContent = 'Remplissez tous les champs.';
    return;
  }

  if (!validDay(data.date) || data.date < todayConakry()
      || !HOURS.includes(data.time)
      || new Date(data.date + 'T' + data.time + ':00Z') <= new Date()) {
    feedback.textContent = 'Choisissez un créneau futur valide.';
    return;
  }

  if (!firebase.auth().currentUser) {
    feedback.textContent = 'Connexion en cours. Réessayez.';
    return;
  }

  const uid = firebase.auth().currentUser.uid;

  // Identifiant permanent du créneau
  const slotId = data.date + '_' + data.time.replace(':', '-');

  // Identifiant unique de cette réservation
  const reservationRef = garageDb.collection('reservations').doc();

  const slotRef = garageDb.collection('slots').doc(slotId);

  const reservation = {
    ...data,
    uid,
    slotId,
    status: 'en_attente',
    createdAt: firebase.firestore.FieldValue.serverTimestamp()
  };

  const slot = {
    date: data.date,
    time: data.time,
    occupied: true,
    uid,
    reservationId: reservationRef.id,
    createdAt: firebase.firestore.FieldValue.serverTimestamp()
  };

  savingReservation = true;
  el('reserveSubmit').disabled = true;
  feedback.textContent = 'Enregistrement en cours...';

  try {
    await garageDb.runTransaction(async transaction => {

  const slotSnapshot = await transaction.get(slotRef);

  // Vérifier si le créneau est déjà réservé
  if (slotSnapshot.exists) {
    throw new Error('Ce créneau est déjà réservé.');
  }

  // Enregistrer le créneau et la réservation ensemble
  transaction.set(slotRef, slot);
  transaction.set(reservationRef, reservation);

});

    feedback.textContent =
      'Votre demande est enregistrée ! Référence : ' +
      reservationRef.id +
      '. Le garage doit encore la confirmer.';

    el('time').value = '';
    refreshSlots();

  } catch (error) {
    console.error('Erreur réservation :', error);

    feedback.textContent =
      'Impossible de réserver. Ce créneau est peut-être déjà pris. ' +
      'Actualisez les disponibilités et réessayez.';

    refreshSlots();

  } finally {
    savingReservation = false;
    el('reserveSubmit').disabled = false;
  }
}


