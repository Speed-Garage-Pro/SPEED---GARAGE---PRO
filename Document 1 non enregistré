let selectedService = "";

function selectService(element) {
  // enlever sélection précédente
  document.querySelectorAll('.selectable').forEach(el => {
    el.classList.remove('selected');
  });

  // ajouter sélection
  element.classList.add('selected');

  // stocker valeur
  selectedService = element.innerText;
}
function goToReservation() {
  if (!selectedService) {
    alert("Veuillez choisir une prestation");
    return;
  }

  // fermer modal entretien
  closeEntretien();

  // ouvrir réservation
  openReservation();

  // remplir automatiquement le service
  document.getElementById("service").value = selectedService;
}
function quickSelect(btn) {
  // reset visuel
  document.querySelectorAll('.service-btn').forEach(b => {
    b.classList.remove('selected');
  });

  btn.classList.add('selected');

  const service = btn.innerText;

  // message WhatsApp direct
  const message = encodeURIComponent(
    `Bonjour 🚗\nJe souhaite un service : ${service}`
  );

  window.open(`https://wa.me/224613816381?text=${message}`, '_blank');
}
function selectServiceAndReserve(btn) {

  // effet visuel sélection
  document.querySelectorAll('.service-btn').forEach(b => {
    b.classList.remove('selected');
  });

  btn.classList.add('selected');

  const service = btn.innerText;

  // ouvrir la réservation
  openReservation();

  // remplir automatiquement le champ service
  document.getElementById("service").value = service;
}
function selectAndOpen(service) {

  // ouvrir le formulaire
  openReservation();

  // attendre que le modal soit visible
  setTimeout(() => {

    const select = document.getElementById("service");

    // sélectionner automatiquement la bonne option
    for (let i = 0; i < select.options.length; i++) {
      if (select.options[i].value === service) {
        select.selectedIndex = i;
        break;
      }
    }

  }, 200);
}
